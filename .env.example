# PLACEHOLDER: reemplazar con la cadena de conexión real de Tiger Data
TIGER_DATA_URL=
# PLACEHOLDER: reemplazar con tu API key de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
# true = usa datos simulados; false = consulta Tiger Data
USAR_DATOS_SIMULADOS=true
DATABASE_URL=

DATABASE_URL_READONLY=

# Asistente SQL: límites locales y esquema autorizado
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_SCHEMA=public

# Solo carga masiva SELECT: timeout por sentencia, en milisegundos.
SQL_LOAD_TIMEOUT_MS=300000

# TODO: Reemplazar con tus API Keys personales de TrendsAPI.
TRENDSAPI_KEY=

# Antigüedad máxima de Parquet limpio en segundos; 0 fuerza recarga en cada arranque.
API_CLEAN_CACHE_MAX_AGE_SECONDS=86400
