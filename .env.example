# PLACEHOLDER: reemplazar con la cadena de conexión real de Tiger Data
TIGER_DATA_URL=
# PLACEHOLDER: reemplazar con tu API key de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
# true = usa datos simulados; false = consulta Tiger Data
USAR_DATOS_SIMULADOS=true
DATABASE_URL=

DATABASE_URL_READONLY=

# Asistente SQL: límites locales y esquema autorizado
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_SCHEMA=public
